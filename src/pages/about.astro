---
import AuthorCard from "../components/AuthorCard.astro";
import { AUTHOR, SITE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `About ${SITE.name}`,
  url: new URL("/about/", Astro.site ?? SITE.url).href,
  description: SITE.description,
};
---

<BaseLayout
  title={`About — ${SITE.name}`}
  description={`Who writes ${SITE.name}, how the analysis is produced, and what we refuse to do.`}
  jsonLd={jsonLd}
>
  <div class="container">
    <main id="main">
      <div class="page-head">
        <h1>About {SITE.name}</h1>
        <p>
          Independent, numbers-first analysis of China cross-border trade — for
          the people actually moving goods and money.
        </p>
      </div>

      <div class="prose" style="margin-top:32px;">
        <h2>Who is behind this</h2>
        <p>
          {AUTHOR.name} — ten years selling on Amazon, Temu, TikTok Shop and D2C,
          based in China and selling globally. No agency, no sponsorship, no
          agenda. The persona is real; the case studies in the archive are the
          writer's own.
        </p>

        <h2>What this site is</h2>
        <ul>
          <li>
            <strong>Numbers first.</strong> Every article carries at least five
            precise figures with a value, unit, date and named official source.
          </li>
          <li>
            <strong>Landed-cost math.</strong> Policy news is only useful once
            it is converted into FOB price × duty rate × container volume.
          </li>
          <li>
            <strong>A clear position.</strong> "Most sellers assume X. The math
            says Y. Do Z." No both-sides hedging.
          </li>
          <li>
            <strong>Named sources only.</strong> Ministry of Commerce, General
            Administration of Customs, National Bureau of Statistics, Xinhua,
            CCTV. No links farmed from other blogs.
          </li>
        </ul>

        <h2>What this site is not</h2>
        <ul>
          <li>Not a news aggregator — no rewriting somebody else's story.</li>
          <li>Not financial or legal advice.</li>
          <li>
            Not ad-funded at the expense of the reader: no tracking pixels, no
            sponsored posts pretending to be analysis.
          </li>
        </ul>

        <h2>Corrections</h2>
        <p>
          If a figure is wrong, it gets corrected and the correction is noted at
          the foot of the article. Email{" "}
          <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>.
        </p>
      </div>
    </main>

    <aside class="sidebar">
      <AuthorCard />
    </aside>
  </div>
</BaseLayout>
