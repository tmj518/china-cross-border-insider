---
import { getCollection, render } from "astro:content";

import { SITE, AUTHOR, categoryLabel } from "../../consts";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { numbersFor, published, relatedPosts } from "../../lib/post";

export async function getStaticPaths() {
  const posts = published(await getCollection("blog"));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(posts, post) },
  }));
}

const { post, related } = Astro.props;
const { data } = post;

const { Content } = await render(post);

const posts = published(await getCollection("blog"));
const numbers = numbersFor(posts);

const canonical = new URL(`/blog/${post.id}/`, Astro.site ?? SITE.url).href;

// Article structured data. The layout renders the visible article; this is the
// machine-readable statement of the same thing, and it stays here because it
// depends on the canonical URL and the site config rather than on the article
// shell.
//
// dateModified takes the latest recorded revision. That is the only signal worth
// emitting: it moves when the content moves. Deriving it from the review clock
// (`reviewBy`) would make a scheduled look into a claimed revision, which is the
// date churn Google describes as manipulation rather than maintenance.
const lastRevision = data.revisions.at(-1);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  ...(data.subtitle ? { alternativeHeadline: data.subtitle } : {}),
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  ...(lastRevision ? { dateModified: lastRevision.date.toISOString() } : {}),
  author: { "@type": "Person", name: AUTHOR.name, jobTitle: AUTHOR.role },
  publisher: { "@type": "Organization", name: SITE.name },
  articleSection: categoryLabel(data.category),
  keywords: data.tags.join(", "),
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
};
---

<BaseLayout
  title={data.subtitle
    ? `${data.title} — ${data.subtitle} — ${SITE.name}`
    : `${data.title} — ${SITE.name}`}
  description={data.description}
  ogType="article"
  image={data.heroImage}
  publishedTime={data.publishDate}
  modifiedTime={data.updatedDate}
  jsonLd={jsonLd}
>
  <ArticleLayout post={post} related={related} numbers={numbers}>
    <Content />
  </ArticleLayout>
</BaseLayout>
