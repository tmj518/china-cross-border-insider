---
/**
 * The guide index: every published guide, grouped by cluster.
 *
 * This page exists so that a guide is reachable from something other than the sitemap. A section that
 * only a crawler can find is a section with no internal links, and internal links are the only
 * authority this site can hand a new page.
 */
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";

const TOPIC_LABEL = {
  "work-visa": "Work visas",
  residence: "Residence permits",
  tax: "Tax",
  "social-insurance": "Social insurance",
  relocation: "Relocating",
  transit: "Transit and entry",
  driving: "Driving",
  employment: "Employing people",
};

const guides = (await getCollection("guide"))
  .filter((g) => g.data.draft !== true)
  .sort((a, b) => String(b.data.lastVerified).localeCompare(String(a.data.lastVerified)));

const byTopic = new Map();
for (const g of guides) {
  const t = g.data.topic;
  if (!byTopic.has(t)) byTopic.set(t, []);
  byTopic.get(t).push(g);
}

const groups = [...byTopic.entries()].sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout
  title={`Guides to what China costs you — ${SITE.name}`}
  description="What it costs to move to, work in, or visit China: fees with the date they were checked, steps in order, and the source for every figure."
>
  <main class="wrap">
    <h1 class="section-title">Guides</h1>
    <p class="guide-standfirst">
      What it costs to move to, work in or visit China — written per unit, with the date each figure was
      checked. Every guide lists its steps in order and names the source behind every number.
    </p>

    {
      guides.length === 0 ? (
        <p class="empty-note">The first guides are being written. Check back shortly.</p>
      ) : (
        groups.map(([topic, items]) => (
          <section class="guide-group">
            <h2 class="section-title">{TOPIC_LABEL[topic] ?? topic}</h2>
            <ul class="guide-list">
              {items.map((g) => (
                <li>
                  <a href={`/guide/${g.id}/`}>{g.data.title}</a>
                  <span class="guide-meta">
                    {g.data.unit} · checked {g.data.lastVerified}
                  </span>
                  <p class="guide-excerpt">{g.data.description}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </main>
</BaseLayout>

<style>
  .guide-standfirst {
    max-width: 62ch;
    margin: 0 0 2rem;
    line-height: 1.6;
  }
  .guide-group {
    margin-bottom: 2.5rem;
  }
  .guide-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .guide-list li {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding: 1rem 0;
  }
  .guide-list a {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .guide-meta {
    margin-left: 0.6rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }
  .guide-excerpt {
    margin: 0.35rem 0 0;
    max-width: 70ch;
    line-height: 1.55;
  }
</style>
