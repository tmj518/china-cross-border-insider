---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { AUTHOR, CF_ANALYTICS_TOKEN, SITE } from "../consts";

/**
 * Site chrome + the SEO head.
 *
 * spec §2 makes Google the acquisition channel, so every page ships a
 * canonical URL, a description, Open Graph / Twitter cards and optional
 * JSON-LD — none of which the HTML prototype had.
 */
export interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogType = "website",
  image = "/og-default.png",
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href="/rss.xml"
    />
    <meta name="theme-color" content="#0a2540" />
    <meta name="author" content={AUTHOR.name} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      blocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <slot />
    <Footer />

    {
      /*
       * Cloudflare Web Analytics. No cookies, so no consent banner — which is
       * the reason this was chosen over GA4 (进度日志 §2). Rendered only when
       * the token is present, so local dev and any fork stay clean.
       *
       * The whole tag is emitted as one raw string, and that is deliberate:
       *   - `is:inline` keeps Astro from bundling it, and `defer` keeps it off
       *     the critical path so the script cannot affect what it measures.
       *   - The beacon wants `{"token":"..."}` in the attribute. Letting Astro
       *     build that attribute escapes every double quote to &quot;, which a
       *     browser decodes but which does not match Cloudflare's snippet.
       *   - `set:html` on the <script> element writes inside the element, not
       *     into its attribute list. The first version of this used that and
       *     rendered the token as script *text*:
       *       <script src="..."> data-cf-beacon='{"token":"..."}'</script>
       *     which loads the beacon with no configuration at all. Writing the
       *     full tag avoids both problems.
       *
       * The token is a 32-character hex string from the dashboard, so nothing
       * here can inject markup — but the guard below enforces that shape
       * instead of trusting it.
       *
       * No `is:inline` on the emitted tag: raw HTML never reaches Astro's
       * directive processing, so writing it there would ship a literal unknown
       * attribute. It is unnecessary anyway — a string passed to set:html is
       * already not processed.
       */
      /^[a-f0-9]{32}$/i.test(CF_ANALYTICS_TOKEN) && (
        <Fragment
          set:html={`<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"${CF_ANALYTICS_TOKEN}"}'></script>`}
        />
      )
    }
  </body>
</html>
