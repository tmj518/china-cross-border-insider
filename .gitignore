# build output
dist/
.astro/

# Generated media. `build/video/` holds rendered slides, narration and the
# assembled MP4 — tens of megabytes per article, and all of it reproducible
# from the article plus tools/make-video.py. Only the YouTube id is committed.
build/

# Environment setup scratch
_env_setup/

# Python
__pycache__/
*.pyc

# dependencies
node_modules/

# environment
# `.env.r2` holds a Cloudflare API token with Object Read & Write on the media
# bucket. The literal names below did not cover it, so a credential file would
# have been committable. Match the whole family and re-admit only templates.
.env
.env.*
!.env.example
!.env.r2.example
.env.production
.env.local

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# Agent scratch space. Research agents download HTML, PDF and text extracts
# here. It is working material, not site content: keeping it out of the repo
# stops multi-megabyte PDFs landing in git history on every `git add -A`.
# The sources are cited by name in each article's frontmatter instead.
_research/
_research_tmp/
_research_*/
*-evidence/
landed-math-dossier-*.txt
*_dossier*.txt
*dossier*.md

# curl -o NONE creates a real file on Windows (NUL is the reserved name)
NONE

# Research agent scratch. Third time this has been swept in by git add -A:
# agents write working files at the repository root, and directory names vary
# by task (cbam/, out/). Patterns now cover the shapes rather than the names.
cbam/
out/
p_*.txt
*.bin
_probe*
fetch.py
fetch.ps1
get.ps1
h2t.py
lang.py
probe.py
search.py
cellar*.py
crop.py
