# Cloudflare Pages headers — copied verbatim into dist/ by Astro.
# spec §2 runs the site on CF Pages, so this is where security headers live.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # No analytics, no ad networks — so nothing third-party needs allowing.
  #
  # Content-Security-Policy is NOT set here. It is generated by Astro
  # (security.csp in astro.config.mjs) and emitted as a meta tag, because a
  # hand-written script-src cannot know the hashes of the scripts Astro emits.
  #
  # This line used to read `script-src 'self'`, and Astro inlines page scripts by
  # default, so the browser refused every one of them. The mobile Menu button did
  # nothing and there was no error anywhere in the build or the deploy — it took a
  # real browser clicking it to find out. Do not put a hand-written CSP back here:
  # two policies intersect, and the stricter one wins.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og-default.png
  Cache-Control: public, max-age=604800
